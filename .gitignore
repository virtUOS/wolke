# Go
/bin/
*.test
*.out
coverage.*

# The embedded SPA: the real assets are generated by `vite build` and copied in
# at build time by `make embed`. Build output is never committed (CLAUDE.md
# "Commits and CI") — a tracked .gitkeep keeps the directory (and go:embed's
# `all:dist` pattern) present on a fresh clone; the server degrades gracefully
# when index.html isn't there yet (internal/web/web.go).
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Frontend
/web-ui/node_modules/
/web-ui/dist/
/web-ui/.vite/
/web-ui/coverage/

# Playwright e2e (docs/specs/responsive-viewport-testing.md): the stored login
# state, run artifacts and the HTML report are all regenerated per run.
/web-ui/e2e/.auth/
/web-ui/test-results/
/web-ui/playwright-report/
/web-ui/blob-report/

# Local config & secrets (examples ARE committed; real ones are not)
.env
*.local.yaml

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# design-sync scratch / build output / machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/wolke-ds.css

# Local working material — never upstream. `local-archive/` holds historical
# inputs (design handoffs, HAR captures, seed drafts); `notes` is a personal
# scratchpad; the tool dirs are per-machine agent/editor state.
/local-archive/
/notes
/.playwright-mcp/
/.roo/
/.design-sync/overrides/
