{
  "__inputs": [],
  "title": "wolke",
  "uid": "wolke",
  "schemaVersion": 39,
  "editable": true,
  "tags": [
    "wolke"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "description": "Scrape targets to include. Counters sum across the selection; the shared-state gauges (read from the one Postgres, so every instance reports the same value) take the max instead.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(wolke_active_sessions, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(wolke_active_sessions, instance)",
          "refId": "instance"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "role",
        "label": "Role",
        "description": "Roles to include. They come from the deployment's OIDC claim mapping, so they are read off the metric rather than hardcoded here.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(wolke_service_favorites, role)",
        "query": {
          "qryType": 1,
          "query": "label_values(wolke_service_favorites, role)",
          "refId": "role"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "title": "Clicks per service in range (top 10)",
      "description": "Counter (wolke_service_clicks_total) — per-instance: each instance counts only the clicks it served, so the panel sums across the selected instances to get the fleet total. Never max: that would report the busiest instance instead of the total.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, round(sum by (service) (increase(wolke_service_clicks_total{instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "{{service}}",
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active sessions",
      "description": "Shared-state gauge: read from the one Postgres on every instance's refresh, so every instance reports the same value. Aggregated with max, not sum — summing would multiply the real number by the instance count.",
